{
  "openapi": "3.1.0",
  "info": {
    "title": "ENGRAVE V2 API",
    "description": "Axum router, Tower layers, Serde models, Utoipa annotations, error mapping. The canonical HTTP surface.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/processing-states": {
      "get": {
        "tags": [],
        "operationId": "processing_states",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProcessingState"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "tags": [],
        "operationId": "search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "tags": [],
        "operationId": "version",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "readiness"
        ],
        "properties": {
          "readiness": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ProcessingState": {
        "type": "object",
        "required": [
          "state",
          "terminal",
          "actionable"
        ],
        "properties": {
          "actionable": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/SourceState"
          },
          "terminal": {
            "type": "boolean"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "entry_limit": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string"
          },
          "token_budget": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "results",
          "tokens_used",
          "lexical_candidates",
          "dense_candidates",
          "degraded_mode"
        ],
        "properties": {
          "degraded_mode": {
            "type": "string"
          },
          "dense_candidates": {
            "type": "integer",
            "minimum": 0
          },
          "lexical_candidates": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "tokens_used": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "memory_id",
          "area_id",
          "claim",
          "reason",
          "provenance",
          "applicability",
          "warnings",
          "estimated_tokens"
        ],
        "properties": {
          "applicability": {
            "type": "string"
          },
          "area_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "memory_id": {
            "type": "string"
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SourceState": {
        "type": "string",
        "enum": [
          "uploaded",
          "verified",
          "queued",
          "extracting",
          "chunking",
          "indexing",
          "proposing",
          "ready",
          "partially_ready",
          "failed",
          "quarantined",
          "deleted"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "required": [
          "service",
          "version"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}
