{
  "openapi": "3.1.0",
  "info": {
    "title": "SMASH V2 API",
    "description": "Axum router, Tower layers, Serde models, Utoipa annotations, error mapping. The canonical HTTP surface.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/processing-states": {
      "get": {
        "tags": [],
        "operationId": "processing_states",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProcessingState"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "tags": [],
        "operationId": "version",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "readiness"
        ],
        "properties": {
          "readiness": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ProcessingState": {
        "type": "object",
        "required": [
          "state",
          "terminal",
          "actionable"
        ],
        "properties": {
          "actionable": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/SourceState"
          },
          "terminal": {
            "type": "boolean"
          }
        }
      },
      "SourceState": {
        "type": "string",
        "enum": [
          "uploaded",
          "verified",
          "queued",
          "extracting",
          "chunking",
          "indexing",
          "proposing",
          "ready",
          "partially_ready",
          "failed",
          "quarantined",
          "deleted"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "required": [
          "service",
          "version"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}
